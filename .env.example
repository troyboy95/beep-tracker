# Copy to `.env` (pipeline, repo root) and `web/.env.local` (web). Never commit real values.
# In production these live in GitHub Actions secrets (pipeline) and Vercel env vars (web).

# =========================== Pipeline (GitHub Actions) ===========================

# Supabase Postgres via the Supavisor *session pooler* (IPv4; GitHub runners can't
# reach the IPv6-only direct host). Supabase -> Connect -> "Session pooler".
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Gemini (Google AI Studio -> Get API key). Model + prices are config, not code:
# verify current values at https://ai.google.dev/gemini-api/docs/pricing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PRICE_INPUT_PER_M=0.25
GEMINI_PRICE_OUTPUT_PER_M=1.50

# Identifies our fetcher to source APIs (politeness). Point at the public repo.
HTTP_USER_AGENT=BeepTracker/0.1 (+https://github.com/<your-user>/beep-tracker)

# Called after each successful run so the site refreshes immediately (set after Vercel deploy).
REVALIDATE_URL=https://<your-app>.vercel.app/api/revalidate
REVALIDATE_SECRET=<random 32+ char string, same value in Vercel>

# ============================== Web (Vercel) ======================================

# Supabase -> Project Settings -> API Keys. Publishable key is read-only via RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# REVALIDATE_SECRET (same as above)
